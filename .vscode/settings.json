{
    // Machine-specific: set "godotTools.editorPath.godot4" in your VSCode *user*
    // settings (see DEVELOPMENT.md), not here, so this file works on any OS.
    "godotTools.lsp.headless": true,
    "editor.formatOnPaste": true,
    "editor.insertSpaces": false,
    "github.copilot.enable": {
        "*": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "debug.console.collapseIdenticalLines": false,
    "files.trimTrailingWhitespace": true,
    "files.eol": "\n",
    "search.exclude": {
        "addons/gut": true
    }
}
