{
    // Every task runs a bash script in scripts/. On Windows they run inside
    // the default WSL distro, so tools only need installing on the Linux side.
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "wsl.exe",
                "args": ["--exec", "bash", "-lc"]
            }
        }
    },
    "tasks": [
        {
            "label": "Test",
            "type": "shell",
            "command": "bash scripts/test.sh",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Lint",
            "type": "shell",
            "command": "bash scripts/lint.sh",
            "problemMatcher": {
                "owner": "gdlint",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+\\.gd):(\\d+): (Error): (.+)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Format (check)",
            "type": "shell",
            "command": "bash scripts/format.sh --check",
            "problemMatcher": []
        },
        {
            "label": "Format (apply)",
            "type": "shell",
            "command": "bash scripts/format.sh",
            "problemMatcher": []
        },
        {
            "label": "Doctor",
            "type": "shell",
            "command": "bash scripts/doctor.sh",
            "problemMatcher": []
        }
    ]
}
