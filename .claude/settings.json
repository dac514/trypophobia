{
	"permissions": {
		"allow": [
			"Bash(bash scripts/lint.sh*)",
			"Bash(bash scripts/format.sh*)",
			"Bash(bash scripts/test.sh*)",
			"Bash(bash scripts/doctor.sh*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-post-edit.sh\"",
						"timeout": 60
					}
				]
			}
		]
	}
}